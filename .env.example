# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DOMAIN=example.com
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SITE_URL=https://example.com

# --- Database (docker-compose.prod.yml uses these) ---
POSTGRES_DB=itmag
POSTGRES_USER=itmag
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://itmag:change-me@db:5432/itmag
REDIS_URL=redis://redis:6379/0

# --- Email (SMTP). Without EMAIL_HOST emails are printed to the console. ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=مجله فناوری <no-reply@example.com>
# optional | mandatory | none
ACCOUNT_EMAIL_VERIFICATION=optional

# --- Social login (leave empty to hide the button) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI Daily (Claude API). Without a key, automatic drafting is off. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_DAILY_GENERATE_AT=08:00
AI_DAILY_SEND_AT=09:00
WEEKLY_DIGEST_AT=10:00
